# URL del proyecto. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Clave anon, pública. El insert corre en un server action y RLS limita la tabla a inserts.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp en formato internacional, solo dígitos, sin + ni espacios.
# Ejemplo México: 5215512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL canónica. Se usa en metadata y Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
